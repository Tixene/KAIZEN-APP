{ id: 'hab-1', categoryId: 'cat-1', title: 'Caminar 10 min', type: 'numeric', target: 10, unit: 'min' },

{ id: 'hab-2', categoryId: 'cat-4', title: 'Grooming / Cuidado La Peque', type: 'boolean' },

{ id: 'hab-3', categoryId: 'cat-2', title: 'Lectura de 5 páginas', type: 'numeric', target: 5, unit: 'págs' },

{ id: 'hab-4', categoryId: 'cat-3', title: 'Revisión financiera diaria', type: 'boolean' }

 ],

logs: {}, // Format: 'YYYY-MM-DD': { habitId: value }

victories: [] // Array of { id, date, count, note }

};


// INIT APP

window.onload = function() {

loadState();

updateDateDisplay();

renderDashboard();

renderVictoriesTab();

renderMetricsTab();

renderSettingsTab();

};


// PERSISTENCIA LOCALSTORAGE

function saveState() {

localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));

}


function loadState() {

const saved = localStorage.getItem(STORAGE_KEY);

if (saved) {

try {

appState = JSON.parse(saved);

} catch (e) {

console.error('Error al cargar datos guardados', e);

}

}

}


function getTodayKey() {

const today = new Date();

return today.toISOString().split('T')[0];

}


function updateDateDisplay() {

const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };

const todayStr = new Date().toLocaleDateString('es-ES', options);

document.getElementById('current-date-display').textContent = todayStr.charAt(0).toUpperCase() + todayStr.slice(1);

}


function switchTab(tabName) {

// Hide all tabs

['dashboard', 'victories', 'metrics', 'settings'].forEach(t => {

document.getElementById(view-${t}`).classList.add('hidden');


// Desktop nav button

const btn = document.getElementById(tab-btn-${t}`);

if(btn) {

btn.className = 'nav-tab-btn flex-1 py-2.5 px-4 rounded-lg text-sm font-medium transition-all duration-200 flex items-center justify-center gap-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800/50';

}


// Mobile nav button

const mBtn = document.getElementById(mobile-tab-btn-${t}`);

if(mBtn) {

mBtn.className = 'flex flex-col items-center gap-1 text-slate-400 py-1';

}

});


// Show selected

document.getElementById(view-${tabName}`).classList.remove('hidden');


// Highlight button

const activeBtn = document.getElementById(tab-btn-${tabName}`);

if(activeBtn) {

activeBtn.className = 'nav-tab-btn flex-1 py-2.5 px-4 rounded-lg text-sm font-semibold transition-all duration-200 flex items-center justify-center gap-2 bg-emerald-500 text-slate-950 shadow-md';

}


const activeMBtn = document.getElementById(mobile-tab-btn-${tabName}`);

if(activeMBtn) {

activeMBtn.className = 'flex flex-col items-center gap-1 text-emerald-400 py-1';

}


if(tabName === 'metrics') renderMetricsTab();

}


function renderDashboard() {

const container = document.getElementById('habits-container');

container.innerHTML = '';


const todayKey = getTodayKey();

const todayLogs = appState.logs[todayKey] || {};


let totalHabits = appState.habits.length;

let completedCount = 0;


appState.categories.forEach(category => {

const categoryHabits = appState.habits.filter(h => h.categoryId === category.id);

if (categoryHabits.length === 0) return;


const groupDiv = document.createElement('div');

groupDiv.className = 'bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-lg';


let categoryHeaderHTML = &lt;div class="flex items-center gap-2 mb-3 pb-2 border-b border-slate-800 text-slate-300 font-bold text-sm"&gt; &lt;i class="fa-solid ${category.icon} text-emerald-400"></i>

<span>${category.name}&lt;/span&gt; &lt;/div&gt; &lt;div class="space-y-2.5"&gt;;


let habitsHTML = '';


categoryHabits.forEach(habit => {

const val = todayLogs[habit.id] || 0;

let isDone = false;


if (habit.type === 'boolean') {

isDone = val === 1;

if (isDone) completedCount++;

} else {

isDone = val >= habit.target;

if (isDone) completedCount++;

}


habitsHTML += &lt;div class="flex items-center justify-between bg-slate-950/60 border border-slate-800/80 rounded-xl p-3 hover:border-slate-700 transition-all"&gt; &lt;div class="flex items-center gap-3"&gt; &lt;button onclick="toggleHabitCheck('${habit.id}')" class="tap-effect w-8 h-8 rounded-lg flex items-center justify-center transition-all ${isDone ? 'bg-emerald-500 text-slate-950 font-bold shadow-md shadow-emerald-500/20' : 'bg-slate-800 border border-slate-700 text-slate-500 hover:text-slate-300'}"&gt; &lt;i class="fa-solid ${isDone ? 'fa-check' : 'fa-minus'} text-sm"></i>

</button>

<div>

<span class="text-sm font-medium ${isDone ? 'line-through text-slate-500' : 'text-slate-100'}"&gt;${habit.title}</span>

${habit.type === 'numeric' ?

<span class="block text-[11px] text-slate-400">Progreso: {habit.target}${habit.unit}&lt;/span&gt; : ''}

</div>

</div>


${habit.type === 'numeric' ?

<div class="flex items-center gap-1 bg-slate-900 border border-slate-800 rounded-lg p-1">

<button onclick="updateHabitValue('{val}</span>

<button onclick="updateHabitValue('${habit.id}', 1)" class="tap-effect w-7 h-7 rounded bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold flex items-center justify-center"&gt;+&lt;/button&gt; &lt;/div&gt; : ''}

</div>

`;

});


groupDiv.innerHTML = categoryHeaderHTML + habitsHTML + '</div>';

container.appendChild(groupDiv);

});


// Update Daily Progress Summary

const percent = totalHabits > 0 ? Math.round((completedCount / totalHabits) * 100) : 0;

document.getElementById('daily-progress-percent').textContent = ${percent}%`; document.getElementById('daily-progress-bar').style.width = `$`{percent}%`; document.getElementById('progress-subtitle').textContent =${completedCount} de ${totalHabits} micro-rutinas completadas hoy;


// Update streak and quick stats

const currentStreak = calculateCurrentStreak();

document.getElementById('stat-current-streak').textContent = ``${currentStreak} días 🔥`;


const todayVictories = (appState.victories.find(v => v.date === todayKey) || {}).count || 0;

document.getElementById('stat-today-victories').textContent = ${todayVictories} 🏆`;


document.getElementById('stat-weekly-avg').textContent = ``${calculateWeeklyAverage()}%`;

}


function toggleHabitCheck(habitId) {

const todayKey = getTodayKey();

if (!appState.logs[todayKey]) appState.logs[todayKey] = {};


const habit = appState.habits.find(h => h.id === habitId);

if (!habit) return;


if (habit.type === 'boolean') {

appState.logs[todayKey][habitId] = appState.logs[todayKey][habitId] === 1 ? 0 : 1;

} else {

const currentVal = appState.logs[todayKey][habitId] || 0;

appState.logs[todayKey][habitId] = currentVal >= habit.target ? 0 : habit.target;

}


saveState();

renderDashboard();

}


function updateHabitValue(habitId, delta) {

const todayKey = getTodayKey();

if (!appState.logs[todayKey]) appState.logs[todayKey] = {};


const currentVal = appState.logs[todayKey][habitId] || 0;

const newVal = Math.max(0, currentVal + delta);


appState.logs[todayKey][habitId] = newVal;


saveState();

renderDashboard();

}


function renderVictoriesTab() {

const todayKey = getTodayKey();

const todayEntry = appState.victories.find(v => v.date === todayKey) || { count: 0 };


document.getElementById('victory-count-num').textContent = todayEntry.count || 0;


const container = document.getElementById('victories-history-container');

container.innerHTML = '';


if (appState.victories.length === 0) {

container.innerHTML = <div class="text-center py-6 text-xs text-slate-500"&gt;Aún no registraste micro-victorias. ¡Suma tu primer logro hoy!&lt;/div>;

return;

}


// Sort by date descending

const sorted = [...appState.victories].sort((a, b) => b.date.localeCompare(a.date));

document.getElementById('victory-total-count').textContent = ${sorted.length} entradas`;


sorted.forEach(item => {

const div = document.createElement('div');

div.className = 'bg-slate-900 border border-slate-800 rounded-xl p-3.5 flex items-start justify-between gap-3';

div.innerHTML = &lt;div&gt; &lt;div class="flex items-center gap-2 mb-1"&gt; &lt;span class="text-xs font-bold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20"&gt;${item.date}</span>

<span class="text-xs text-slate-400 font-medium">+{item.note || 'Sin nota adjunta'}</p>

</div>

<button onclick="deleteVictoryEntry('${item.id}')" class="text-slate-600 hover:text-rose-400 text-xs p-1"&gt; &lt;i class="fa-solid fa-trash"&gt;&lt;/i&gt; &lt;/button&gt;;

container.appendChild(div);

});

}


function incrementVictoryCount() {

const todayKey = getTodayKey();

let entry = appState.victories.find(v => v.date === todayKey);


if (!entry) {

entry = { id: 'vic-' + Date.now(), date: todayKey, count: 1, note: '' };

appState.victories.push(entry);

} else {

entry.count += 1;

}


saveState();

renderVictoriesTab();

renderDashboard();

}


function decrementVictoryCount() {

const todayKey = getTodayKey();

let entry = appState.victories.find(v => v.date === todayKey);


if (entry && entry.count > 0) {

entry.count -= 1;

saveState();

renderVictoriesTab();

renderDashboard();

}

}


function handleVictorySubmit(e) {

e.preventDefault();

const input = document.getElementById('victory-input');

const text = input.value.trim();

if (!text) return;


const todayKey = getTodayKey();

let entry = appState.victories.find(v => v.date === todayKey);


if (!entry) {

entry = { id: 'vic-' + Date.now(), date: todayKey, count: 1, note: text };

appState.victories.push(entry);

} else {

entry.note = entry.note ? ``${entry.note} | ${text} : text;

entry.count += 1;

}


input.value = '';

saveState();

renderVictoriesTab();

renderDashboard();

}


function deleteVictoryEntry(id) {

appState.victories = appState.victories.filter(v => v.id !== id);

saveState();

renderVictoriesTab();

renderDashboard();

}


function renderMetricsTab() {

// Render Heatmap (Last 35 days)

const grid = document.getElementById('heatmap-grid');

grid.innerHTML = '';


const days = 35;

const today = new Date();


for (let i = days - 1; i >= 0; i--) {

const d = new Date(today);

d.setDate(d.getDate() - i);

const dateStr = d.toISOString().split('T')[0];


const logs = appState.logs[dateStr] || {};

let done = 0;

let total = appState.habits.length;


appState.habits.forEach(h => {

const val = logs[h.id] || 0;

if (h.type === 'boolean' && val === 1) done++;

if (h.type === 'numeric' && val >= h.target) done++;

});


const ratio = total > 0 ? done / total : 0;


let colorClass = 'bg-slate-800 border-slate-700/50';

if (ratio > 0 && ratio <= 0.33) colorClass = 'bg-emerald-950 border-emerald-800/50 text-emerald-300';

else if (ratio > 0.33 && ratio <= 0.75) colorClass = 'bg-emerald-700 border-emerald-600 text-emerald-100';

else if (ratio > 0.75) colorClass = 'bg-emerald-500 border-emerald-400 text-slate-950 font-bold';


const dayNum = d.getDate();

const cell = document.createElement('div');

cell.className = heatmap-cell rounded-lg border flex flex-col items-center justify-center text-[10px] p-1${colorClass}; cell.title ={done}/{Math.round(ratio*100)}%); cell.innerHTML =<span>${dayNum}&lt;/span>;


grid.appendChild(cell);

}


// Streaks

const currentStreak = calculateCurrentStreak();

const maxStreak = calculateMaxStreak();

document.getElementById('metric-streak-current').textContent = ``${currentStreak} días; document.getElementById('metric-streak-max').textContent =${maxStreak} días;


// Category Metrics Breakdown

const catList = document.getElementById('category-metrics-list');

catList.innerHTML = '';


appState.categories.forEach(cat => {

const habits = appState.habits.filter(h => h.categoryId === cat.id);

const div = document.createElement('div');

div.className = 'bg-slate-950/60 p-3 rounded-xl border border-slate-800 flex items-center justify-between text-xs';

div.innerHTML = &lt;div class="flex items-center gap-2"&gt; &lt;i class="fa-solid${cat.icon} text-purple-400"></i>

<span class="text-slate-300 font-medium">{habits.length} micro-rutinas</span>

`;

catList.appendChild(div);

});

}


function calculateCurrentStreak() {

let streak = 0;

const today = new Date();


for (let i = 0; i < 365; i++) {

const d = new Date(today);

d.setDate(d.getDate() - i);

const dateStr = d.toISOString().split('T')[0];


const logs = appState.logs[dateStr] || {};

let done = 0;

appState.habits.forEach(h => {

const val = logs[h.id] || 0;

if ((h.type === 'boolean' && val === 1) || (h.type === 'numeric' && val >= h.target)) done++;

});


// Consider day completed if >= 50% completed

if (appState.habits.length > 0 && (done / appState.habits.length) >= 0.5) {

streak++;

} else if (i === 0) {

// If today isn't done yet, don't break the streak from yesterday

continue;

} else {

break;

}

}

return streak;

}


function calculateMaxStreak() {

return Math.max(calculateCurrentStreak(), 5); // Fallback mock threshold

}


function calculateWeeklyAverage() {

let totalRatios = 0;

const today = new Date();

for (let i = 0; i < 7; i++) {

const d = new Date(today);

d.setDate(d.getDate() - i);

const dateStr = d.toISOString().split('T')[0];


const logs = appState.logs[dateStr] || {};

let done = 0;

appState.habits.forEach(h => {

const val = logs[h.id] || 0;

if ((h.type === 'boolean' && val === 1) || (h.type === 'numeric' && val >= h.target)) done++;

});


const ratio = appState.habits.length > 0 ? done / appState.habits.length : 0;

totalRatios += ratio;

}

return Math.round((totalRatios / 7) * 100);

}


function renderSettingsTab() {

const container = document.getElementById('categories-manager-list');

container.innerHTML = '';


appState.categories.forEach(cat => {

const habitCount = appState.habits.filter(h => h.categoryId === cat.id).length;

const div = document.createElement('div');

div.className = 'bg-slate-950/60 border border-slate-800 p-3 rounded-xl flex items-center justify-between text-xs';

div.innerHTML = &lt;div class="flex items-center gap-2.5"&gt; &lt;i class="fa-solid ${cat.icon} text-purple-400 text-sm"></i>

<span class="font-medium text-slate-200">${cat.name}&lt;/span&gt; &lt;span class="text-[10px] text-slate-500"&gt;(${habitCount} hábitos)</span>

</div>

<button onclick="deleteCategory('${cat.id}')" class="text-slate-600 hover:text-rose-400 p-1"&gt; &lt;i class="fa-solid fa-trash"&gt;&lt;/i&gt; &lt;/button&gt;;

container.appendChild(div);

});

}


// MODALES & HANDLERS

function openAddHabitModal() {

document.getElementById('modal-habit-title').textContent = 'Nueva Micro-Rutina';

document.getElementById('habit-id').value = '';

document.getElementById('habit-title').value = '';


const select = document.getElementById('habit-category');

select.innerHTML = '';

appState.categories.forEach(c => {

select.innerHTML += <option value="${c.id}">${c.name}&lt;/option>;

});


document.getElementById('modal-habit').classList.remove('hidden');

}


function closeHabitModal() {

document.getElementById('modal-habit').classList.add('hidden');

}


function toggleHabitTypeFields() {

const type = document.getElementById('habit-type').value;

const numFields = document.getElementById('numeric-fields');

if (type === 'numeric') {

numFields.classList.remove('hidden');

} else {

numFields.classList.add('hidden');

}

}


function saveHabit(e) {

e.preventDefault();

const id = document.getElementById('habit-id').value || 'hab-' + Date.now();

const title = document.getElementById('habit-title').value.trim();

const categoryId = document.getElementById('habit-category').value;

const type = document.getElementById('habit-type').value;

const target = parseInt(document.getElementById('habit-target').value) || 1;

const unit = document.getElementById('habit-unit').value.trim() || 'unid';


const existingIndex = appState.habits.findIndex(h => h.id === id);

const newHabit = { id, title, categoryId, type, target, unit };


if (existingIndex >= 0) {

appState.habits[existingIndex] = newHabit;

} else {

appState.habits.push(newHabit);

}


saveState();

closeHabitModal();

renderDashboard();

}


function openAddCategoryModal() {

document.getElementById('modal-category').classList.remove('hidden');

}


function closeCategoryModal() {

document.getElementById('modal-category').classList.add('hidden');

}


function saveCategory(e) {

e.preventDefault();

const name = document.getElementById('category-name').value.trim();

const icon = document.getElementById('category-icon').value;


if (!name) return;


appState.categories.push({

id: 'cat-' + Date.now(),

name,

icon

});


saveState();

closeCategoryModal();

renderSettingsTab();

renderDashboard();

}


function deleteCategory(catId) {

if (appState.categories.length <= 1) {

alert('Debes mantener al menos una categoría activa.');

return;

}

appState.categories = appState.categories.filter(c => c.id !== catId);

appState.habits = appState.habits.filter(h => h.categoryId !== catId);

saveState();

renderSettingsTab();

renderDashboard();

}


// BACKUP & RESTORE

function exportData() {

const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appState, null, 2));

const downloadAnchor = document.createElement('a');

downloadAnchor.setAttribute("href", dataStr);

downloadAnchor.setAttribute("download", kaizen_flow_backup_${getTodayKey()}.json);

document.body.appendChild(downloadAnchor);

downloadAnchor.click();

downloadAnchor.remove();

}


function triggerImport() {

document.getElementById('import-file-input').click();

}


function importData(e) {

const file = e.target.files[0];

if (!file) return;


const reader = new FileReader();

reader.onload = function(event) {

try {

const imported = JSON.parse(event.target.result);

if (imported.categories && imported.habits) {

appState = imported;

saveState();

location.reload();

} else {

alert('Formato de archivo JSON no válido.');

}

} catch (err) {

alert('Error al leer el archivo de copia de seguridad.');

}

};

reader.readAsText(file);

}


function confirmResetAll() {

if (confirm('¿Estás seguro de reiniciar todos los datos? Esta acción eliminará tu historial actual.')) {

localStorage.removeItem(STORAGE_KEY);

location.reload();

}

}

</script>

